      "name": "Pick Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        -336,
        -176
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const subject = item.json.Subject || \"\";\n  const snippet = item.json.Snippet || \"\";\n  const text = (subject + \" \" + snippet).toLowerCase();\n\n  let category = \"Others\";\n  if (/(payment|paid|invoice|bill|transaction|bank|refund)/i.test(text)) {\n    category = \"Payment\";\n  } else if (/(^hi |^hello | dear|family|friend|birthday|party|invitation)/i.test(text)) {\n    category = \"Personal\";\n  } else if (/(course|tutorial|lesson|exam|study|training|class)/i.test(text)) {\n    category = \"Learning\";\n  } else if (/(offer|sale|discount|deal|promotion|coupon)/i.test(text)) {\n    category = \"Offer\";\n  }\n\n  item.json.Category = category;\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
