    {
      "parameters": {
        "jsCode": "// Run Once for All Items\nfunction parseViews(v) {\n  if (v == null) return 0;\n  if (typeof v === 'number') return v;\n  const s = String(v).trim().toUpperCase();       // e.g., \"1.2M\", \"345K\", \"2,345\"\n  const m = s.match(/^([\\d,.]+)\\s*([KMB])?/);\n  if (!m) return 0;\n  const num = parseFloat(m[1].replace(/,/g, ''));\n  const suf = m[2] || '';\n  const mult = suf === 'B' ? 1e9 : suf === 'M' ? 1e6 : suf === 'K' ? 1e3 : 1;\n  return Math.round(num * mult);\n}\n\nconst videos = items.map(i => {\n  const j = i.json || {};\n  const videoId = j.videoId || j.videoID || j.id || '';\n  return {\n    videoId,\n    title: j.title || '',\n    url: j.url || (videoId ? `https://www.youtube.com/watch?v=${videoId}` : ''),\n    views: parseViews(j.viewCount || j.views),\n    channelId: j.channelId || j.channelID || '',\n    channelName: j.channelName || '',\n    publishedAt: j.datePublished || j.publishedAt || '',\n    thumbnail: j.thumbnailUrl || ''\n  };\n});\n\nvideos.sort((a,b) => b.views - a.views);\nconst top10 = videos.slice(0, 10);\nreturn top10.map(v => ({ json: v }));\n"
      },
