      "id": "924525e7-4f4b-4b6f-8193-38527e81ff10",
      "name": "Code (Normalize Transcript)"
    },
    {
      "parameters": {
        "jsCode": "function safeParse(s){ try { return JSON.parse(String(s||'').trim()); } catch { return {}; } }\n\n// get LLM text from common shapes\nlet content = '';\nif ($json.message && typeof $json.message.content === 'string') content = $json.message.content;\nelse if ($json.text) content = $json.text;\nelse if ($json.data && $json.data[0] && $json.data[0].content) content = $json.data[0].content;\nelse if ($json.choices && $json.choices[0]) content = $json.choices[0].message?.content || $json.choices[0].text || '';\nelse if ($json.result) content = $json.result;\n\nconst llm = safeParse(content);\n\nconst key_concepts     = Array.isArray(llm.key_concepts) ? llm.key_concepts : [];\nconst recurring_themes = Array.isArray(llm.recurring_themes) ? llm.recurring_themes : [];\nconst unique_angles    = Array.isArray(llm.unique_angles) ? llm.unique_angles : [];\nconst summary          = typeof llm.one_sentence_summary === 'string' ? llm.one_sentence_summary : '';\n\nreturn [{\n  json: {\n    ChannelId:  $json.ChannelId || $json.channelId || '',\n    VideoId:    $json.VideoId   || $json.videoId   || '',\n    Title:      $json.Title     || $json.title     || '',\n    URL:        $json.URL       || $json.url       || '',\n    Views:      $json.Views     ??  $json.views    ?? 0,\n    Transcript: $json.Transcript || $json.transcript || '',\n\n    KeyConcepts:     key_concepts.join(' | '),\n    RecurringThemes: recurring_themes.join(' | '),\n    UniqueAngles:    unique_angles.join(' | '),\n    Summary:         summary,\n\n    AppendedAt: new Date().toISOString()\n  }\n}];\n"
      },
