    {
      "parameters": {
        "jsCode": "const j = $json || {};\nlet text = '';\n\n// transcript pick from any possible field (from HTTP)\nif (Array.isArray(j.segments)) {\n  text = j.segments.map(s => s.text || s.caption || '').join(' ');\n} else if (typeof j.transcriptionAsText === 'string') {\n  text = j.transcriptionAsText;\n} else if (typeof j.text === 'string') {\n  text = j.text;\n} else if (typeof j.transcript === 'string') {\n  text = j.transcript;\n}\n\n// cleanup + trim\ntext = String(text || '')\n  .replace(/\\s+/g, ' ')\n  .replace(/\\[?\\d{1,2}:\\d{2}(?::\\d{2})?\\]?:?/g, '')\n  .trim();\n\nconst MAX_FOR_LLM = 6000;\nconst transcript_for_llm = text.slice(0, MAX_FOR_LLM);\n\n// meta (aab $json me hi present hoga kyunki M1 ne merge kar diya)\nconst VideoId   = j.VideoId   ?? j.videoId   ?? '';\nconst ChannelId = j.ChannelId ?? j.channelId ?? '';\nconst Title     = j.Title     ?? j.title     ?? '';\nconst Views     = j.Views     ?? j.views     ?? 0;\nconst URL       = j.URL ?? j.url ?? (VideoId ? `https://www.youtube.com/watch?v=${VideoId}` : '');\n\nreturn [{\n  json: {\n    ChannelId,\n    VideoId,\n    Title,\n    URL,\n    Views,\n    Transcript: text,                 // full\n    _transcript_for_llm: transcript_for_llm\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
