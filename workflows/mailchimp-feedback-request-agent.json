      "parameters": {
        "jsCode": "// Keep only members who DON'T have 'feedback_given' AND DON'T have 'Requested'\nreturn items.filter(({ json }) => {\n  const tags = Array.isArray(json.tags) ? json.tags : [];\n  const names = tags.map(t => t?.name ?? t);\n  const noFeedbackYet = !names.includes('feedback_given');\n  const notAlreadyRequested = !names.includes('Requested');\n  return noFeedbackYet && notAlreadyRequested;\n});\n"
      },
