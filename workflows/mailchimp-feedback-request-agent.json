        "message": "=<!DOCTYPE html> <html> <head>     <meta charset=\"utf-8\">     <title>Feedback Request</title> </head> <body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">     <div style=\"max-width: 600px; margin: 0 auto; padding: 20px;\">         <h2 style=\"color: #2c3e50;\">Hi {{ $json.merge_fields.FNAME || 'there' }}!</h2>                  <p>We hope you've been enjoying our services! Your opinion matters a lot to us, and we'd love to hear about your experience.</p>                  <p>Could you take just 2 minutes to share your feedback? It helps us improve and serve you better.</p>                  <div style=\"text-align: center; margin: 30px 0;\">             <a href=\"https://your-feedback-form.com\" style=\"background-color: #3498db; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; display: inline-block;\">Give Feedback</a>         </div>                  <p>Thank you for being a valued customer!</p>                  <p>Best regards,<br>Your Team</p>     </div> </body> </html>",
