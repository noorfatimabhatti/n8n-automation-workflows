        "jsCode": "const list = Array.isArray($json.trending_searches) ? $json.trending_searches : [];\nlist.sort((a, b) => (b.search_volume || 0) - (a.search_volume || 0));\nconst top = list[0];\n\nreturn [{\n  topic: top?.query\n    || (Array.isArray($json.trend_breakdown) && $json.trend_breakdown[0])\n    || ''\n}];"
